@{
    ViewData["Title"] = "Home";
}

<div id="app-container" class="min-h-screen relative">
    <!-- Splash View -->
    <div id="splash-view" class="h-screen w-full flex flex-col items-center justify-center text-white relative overflow-hidden">
        <div class="w-32 h-32 bg-white/10 backdrop-blur-2xl rounded-4xl flex items-center justify-center mb-10 border border-white/20 shadow-2xl animate-pulse">
            <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white"><path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4.9l-1.4 2.9A3.7 3.7 0 0 0 2 12v4c0 .6.4 1 1 1h2"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/><path d="M5 17h2"/><path d="M9 17h6"/><path d="M14 7v3"/><path d="M17 17h2"/></svg>
        </div>
        <h1 class="text-6xl font-black tracking-tighter mb-2 italic text-gradient text-center">MoveSafe Uganda</h1>
        <p class="text-indigo-300/80 font-medium text-xs tracking-[0.4em] uppercase mb-12">Mobility Redefined</p>
        
        <div class="flex gap-2">
            <div class="w-2 h-2 rounded-full bg-indigo-400 animate-bounce"></div>
            <div class="w-2 h-2 rounded-full bg-indigo-400 animate-bounce" style="animation-delay: 0.2s"></div>
            <div class="w-2 h-2 rounded-full bg-indigo-400 animate-bounce" style="animation-delay: 0.4s"></div>
        </div>

        <div class="absolute bottom-12 font-mono text-[9px] font-medium tracking-[0.5em] text-white/30 uppercase">
            Uptime: 99.9% // Node: UG-KLA-01
        </div>
    </div>

    <!-- Login View (Hidden by default) -->
    <div id="login-view" class="p-8 pt-20 min-h-screen flex flex-col relative hidden">
        <div class="mb-14">
            <div class="flex items-center gap-3 mb-4">
               <div class="w-2 h-2 rounded-full bg-indigo-400 animate-pulse"></div>
               <span class="label-mono">System Gateway</span>
            </div>
            <h2 class="text-7xl font-bold text-white tracking-tighter leading-[0.85] mb-6 font-display italic">
                TRAVEL<br/>
                <span class="text-gradient">BEYOND</span>
            </h2>
            <p class="text-white/40 font-medium text-sm leading-relaxed max-w-[240px]">
                Seamless integration of transit and technology for the modern traveler.
            </p>
        </div>

        <form asp-controller="Account" asp-action="Login" method="post" class="flex flex-col flex-1">
            <div asp-validation-summary="All" class="text-red-400 text-[10px] font-bold uppercase mb-4 px-2"></div>
            <div class="glass p-1.5 rounded-3xl flex mb-12">
                <button type="button" id="role-passenger" class="flex-1 py-4 rounded-2xl font-bold text-sm transition-all bg-white text-indigo-900 shadow-xl">
                    PASSENGER
                </button>
                <button type="button" id="role-driver" class="flex-1 py-4 rounded-2xl font-bold text-sm transition-all text-white/40">
                    DRIVER
                </button>
            </div>

            <div class="space-y-6">
                <div class="space-y-3">
                    <label class="label-mono">Email Address</label>
                    <div class="input-wrap">
                        <input type="email" name="Email" required class="bg-transparent border-none outline-none font-bold w-full text-white placeholder:text-white/20" placeholder="name@example.com" />
                    </div>
                </div>
                <div class="space-y-3">
                    <label class="label-mono">Security Access Key</label>
                    <div class="input-wrap">
                       <input type="password" name="Password" required placeholder="••••••••" class="bg-transparent border-none outline-none font-bold w-full text-white placeholder:text-white/20" />
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <input type="checkbox" name="RememberMe" id="RememberMe" class="w-4 h-4 rounded border-white/10 bg-white/5" />
                    <label for="RememberMe" class="label-mono !text-[10px]">Keep Session Active</label>
                </div>
            </div>

            <button type="submit" class="btn-primary mt-12">
                INITIATE SESSION
            </button>

            <a asp-controller="Home" asp-action="Dashboard" class="btn-guest mt-6 w-full text-center flex items-center justify-center">
                GUEST ACCESS
            </a>

            <div class="mt-auto flex justify-between px-4 pb-12">
                <button type="button" class="text-white/30 font-medium text-xs hover:text-white transition-colors">FORGOT KEY?</button>
                <a asp-controller="Account" asp-action="Register" class="text-indigo-400 font-bold text-xs underline underline-offset-8">
                    GENERATE ACCOUNT
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // Transitions
            setTimeout(() => {
                document.getElementById('splash-view').classList.add('hidden');
                document.getElementById('login-view').classList.remove('hidden');
            }, 2500);

            // Role toggle
            const pBtn = document.getElementById('role-passenger');
            const dBtn = document.getElementById('role-driver');

            pBtn.addEventListener('click', () => {
                pBtn.className = "flex-1 py-4 rounded-2xl font-bold text-sm transition-all bg-white text-indigo-900 shadow-xl";
                dBtn.className = "flex-1 py-4 rounded-2xl font-bold text-sm transition-all text-white/40";
            });

            dBtn.addEventListener('click', () => {
                dBtn.className = "flex-1 py-4 rounded-2xl font-bold text-sm transition-all bg-white text-indigo-900 shadow-xl";
                pBtn.className = "flex-1 py-4 rounded-2xl font-bold text-sm transition-all text-white/40";
            });
        });
    </script>
}
