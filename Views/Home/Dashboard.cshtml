@using Microsoft.AspNetCore.Identity
@using MatatuMVC.Models
@using Microsoft.EntityFrameworkCore
@inject UserManager<User> UserManager
@inject MatatuMVC.Data.MatatuContext context

@{
    ViewData["Title"] = "Dashboard";
    var user = await UserManager.GetUserAsync(User);
}

<!-- GLOBAL NAVIGATION STYLES -->
<style>
    .tab-view { display: none; }
    .tab-view.active { display: block; animation: fadeIn 0.3s ease-out; }
    @@keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    .nav-item.active { color: #818cf8 !important; }
    .nav-item.active svg { transform: scale(1.1); filter: drop-shadow(0 0 8px rgba(129, 140, 248, 0.4)); }
</style>

<div class="relative w-full max-w-lg mx-auto bg-[#0f172a] min-h-screen shadow-2xl">

    <!-- HOME VIEW -->
    <div id="view-Home" class="tab-view active p-8 pb-32">
        <header class="flex justify-between items-center mb-10 pt-4">
            <div>
                <h1 class="text-4xl font-bold tracking-tighter text-white font-display mb-1">MoveSafe <span class="text-indigo-400">UG</span></h1>
                <p class="text-white/40 text-[10px] font-black uppercase tracking-[0.3em]">Transit OS · Kampala</p>
            </div>
            <div class="w-12 h-12 glass rounded-2xl p-0.5 border border-white/10 shadow-lg">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@(user?.Name ?? "Guest")" class="w-full h-full rounded-2xl object-cover" />
            </div>
        </header>

        <div class="glass p-8 rounded-[40px] border border-white/5 shadow-2xl relative overflow-hidden mb-10">
            <div class="absolute top-0 right-0 w-32 h-32 bg-indigo-500/10 rounded-full blur-3xl -mr-16 -mt-16"></div>
            <h2 class="text-2xl font-bold text-white mb-6 leading-tight">Welcome Back,<br/><span class="text-indigo-400">@(user?.Name?.Split(' ')[0] ?? "Traveler")</span></h2>
            
            <div class="grid grid-cols-2 gap-4">
                <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
                    <p class="text-[9px] font-bold text-white/30 uppercase mb-1">Daily Trips</p>
                    <p class="text-xl font-bold text-white">14 Active</p>
                </div>
                <div class="bg-white/5 p-4 rounded-2xl border border-white/5">
                    <p class="text-[9px] font-bold text-white/30 uppercase mb-1">System Load</p>
                    <p class="text-xl font-bold text-green-400">Optimal</p>
                </div>
            </div>
        </div>

        <div class="space-y-4">
            <h3 class="text-xs font-black text-white/20 uppercase tracking-[0.2em] mb-4">Quick Actions</h3>
            <button onclick="switchTab('Map')" class="w-full glass p-5 rounded-2xl border border-white/5 flex items-center justify-between group hover:bg-white/10 transition-all">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform"><i class="fas fa-map-marked-alt"></i></div>
                    <span class="font-bold text-white">Find Matatu Near Me</span>
                </div>
                <i class="fas fa-chevron-right text-white/20"></i>
            </button>
            <button onclick="switchTab('Tickets')" class="w-full glass p-5 rounded-2xl border border-white/5 flex items-center justify-between group hover:bg-white/10 transition-all">
                <div class="flex items-center gap-4">
                    <div class="w-10 h-10 rounded-xl bg-green-500/10 flex items-center justify-center text-green-400 group-hover:scale-110 transition-transform"><i class="fas fa-ticket-alt"></i></div>
                    <span class="font-bold text-white">My Active Tickets</span>
                </div>
                <i class="fas fa-chevron-right text-white/20"></i>
            </button>
        </div>
    </div>

    <!-- INBOX VIEW -->
    <div id="view-Inbox" class="tab-view p-8 pb-32">
        <h2 class="text-3xl font-bold text-white mb-8 pt-8">Inbox</h2>
        <div class="space-y-4">
            <div class="glass p-5 rounded-2xl border-l-4 border-indigo-500">
                <div class="flex justify-between items-start mb-2">
                    <h5 class="font-bold text-white text-sm">Payment Confirmed</h5>
                    <span class="text-[10px] text-white/40">2m ago</span>
                </div>
                <p class="text-xs text-white/50 leading-relaxed">Your UGX 2,500 payment for Trip #MS-992 was successful.</p>
            </div>
            <div class="glass p-5 rounded-2xl border-l-4 border-green-500">
                <div class="flex justify-between items-start mb-2">
                    <h5 class="font-bold text-white text-sm">Trip Starting</h5>
                    <span class="text-[10px] text-white/40">15m ago</span>
                </div>
                <p class="text-xs text-white/50 leading-relaxed">Matatu UBL 402P has started the route to Old Taxi Park.</p>
            </div>
            <div class="glass p-5 rounded-2xl opacity-40">
                <div class="flex justify-between items-start mb-2">
                    <h5 class="font-bold text-white text-sm">System Update</h5>
                    <span class="text-[10px] text-white/40">Yesterday</span>
                </div>
                <p class="text-xs text-white/50 leading-relaxed">New hub added: Ntinda Stage is now live!</p>
            </div>
        </div>
    </div>

    <!-- MAP VIEW -->
    <div id="view-Map" class="tab-view" style="position:fixed;inset:0;bottom:80px;z-index:10;background:#0f172a;">
        <div id="matatuMap" style="width:100%;height:100%;"></div>
        <div class="absolute top-8 left-6 right-6 z-[400]">
            <div class="glass p-4 rounded-2xl border border-white/10 shadow-2xl flex items-center gap-3 backdrop-blur-xl">
                <i class="fas fa-search text-indigo-400"></i>
                <input type="text" placeholder="Locate Hub or Vehicle..." class="bg-transparent border-none outline-none text-white text-sm w-full placeholder:text-white/20" />
            </div>
        </div>
        <!-- Hub Pills -->
        <div class="absolute bottom-6 left-0 right-0 z-[400] px-6 flex gap-2 overflow-x-auto no-scrollbar">
            <button onclick="flyToHub('old')" class="glass px-4 py-2 rounded-full text-[10px] font-black text-white/70 whitespace-nowrap border border-white/5">OLD TAXI PARK</button>
            <button onclick="flyToHub('new')" class="glass px-4 py-2 rounded-full text-[10px] font-black text-white/70 whitespace-nowrap border border-white/5">NEW TAXI PARK</button>
            <button onclick="flyToHub('ntinda')" class="glass px-4 py-2 rounded-full text-[10px] font-black text-white/70 whitespace-nowrap border border-white/5">NTINDA</button>
        </div>
    </div>

    <!-- TICKETS VIEW -->
    <div id="view-Tickets" class="tab-view p-8 pb-32">
        <h2 class="text-3xl font-bold text-white mb-8 pt-8 font-display italic">Tickets</h2>
        <div class="space-y-5">
            <div class="glass p-6 rounded-3xl border border-white/10 relative overflow-hidden group hover:border-indigo-500/50 transition-all">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <p class="label-mono text-indigo-400 text-[9px] mb-1 tracking-[0.2em] uppercase font-bold">#MS-88102-KLA</p>
                        <h4 class="font-bold text-xl text-white">Old Taxi Park → Kisaasi</h4>
                    </div>
                    <div class="bg-indigo-500/20 px-3 py-1 rounded-full text-[10px] font-black text-indigo-300">ACTIVE</div>
                </div>
                <div class="flex justify-between items-end border-t border-white/5 pt-4">
                    <div>
                        <p class="text-[9px] text-white/30 font-bold uppercase mb-1">Standard Fare</p>
                        <p class="text-lg font-bold text-white tracking-tight">UGX 2,500</p>
                    </div>
                    <button class="bg-white/5 hover:bg-white/10 p-3 rounded-2xl transition-all"><i class="fas fa-qrcode text-white/60"></i></button>
                </div>
            </div>
            
            <div class="glass p-6 rounded-3xl border border-white/5 opacity-50">
                <div class="flex justify-between items-start mb-6">
                    <div>
                        <p class="label-mono text-white/30 text-[9px] mb-1 uppercase font-bold">#MS-77192-NTN</p>
                        <h4 class="font-bold text-xl text-white">Wandegeya → Ntinda</h4>
                    </div>
                    <div class="bg-white/5 px-3 py-1 rounded-full text-[10px] font-black text-white/40">USED</div>
                </div>
            </div>
        </div>
    </div>

    <!-- TRIPS VIEW -->
    <div id="view-Trips" class="tab-view p-8 pb-32">
        <h2 class="text-3xl font-bold text-white mb-8 pt-8">Real-Time Trips</h2>
        <div class="space-y-4">
            <div class="glass p-6 rounded-3xl border border-white/5 relative">
                <div class="flex justify-between items-center mb-4">
                    <span class="flex items-center gap-2 text-green-400 text-[10px] font-black uppercase tracking-widest">
                        <span class="w-2 h-2 rounded-full bg-green-400 animate-pulse"></span> Boarding Now
                    </span>
                    <p class="text-white/20 text-[10px] font-bold uppercase">UBL 902X</p>
                </div>
                <h4 class="text-xl font-bold text-white mb-1">Kampala → Entebbe</h4>
                <p class="text-white/40 text-xs mb-6">Departure: 10:45 AM · 4 Seats Remaining</p>
                <button class="w-full btn-primary py-4 rounded-2xl text-[11px] font-black tracking-widest shadow-lg shadow-indigo-500/20">BOOK SEAT</button>
            </div>

            <div class="glass p-6 rounded-3xl border border-white/5">
                <div class="flex justify-between items-center mb-4">
                    <span class="text-indigo-400 text-[10px] font-black uppercase tracking-widest">In 20 Mins</span>
                    <p class="text-white/20 text-[10px] font-bold uppercase">UBH 112P</p>
                </div>
                <h4 class="text-xl font-bold text-white mb-1">Old Taxi Park → Namugongo</h4>
                <p class="text-white/40 text-xs">Departure: 11:15 AM · 12 Seats Remaining</p>
            </div>
        </div>
    </div>

    <!-- PROFILE VIEW -->
    <div id="view-Profile" class="tab-view p-8 pb-32">
        <h2 class="text-3xl font-bold text-white mb-8 pt-8">My Account</h2>
        <div id="profileContainer">
            <div class="glass p-10 rounded-[40px] text-center border border-white/10 shadow-2xl relative overflow-hidden">
                <div class="absolute -top-10 -left-10 w-40 h-40 bg-indigo-500/5 rounded-full blur-3xl"></div>
                <div class="w-32 h-32 rounded-full mx-auto mb-6 bg-indigo-500/20 p-1 border-4 border-indigo-500/30">
                    <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@(user?.Name ?? "Guest")" class="w-full h-full rounded-full bg-slate-800" />
                </div>
                <h4 class="font-bold text-3xl text-white mb-1">@(user?.Name ?? "Guest Traveler")</h4>
                <p class="text-indigo-300/60 text-sm font-medium tracking-wide mb-6">@(user?.Email ?? "No account linked")</p>
                
                <div class="inline-block px-6 py-2 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-[10px] font-black uppercase tracking-[0.2em]">
                    @(user?.Role.ToString() ?? "Guest Access")
                </div>

                <div class="grid grid-cols-2 gap-4 mt-10 pt-8 border-t border-white/5">
                    <div class="text-left">
                        <p class="text-[9px] text-white/30 font-black uppercase tracking-widest mb-1">Join Date</p>
                        <p class="text-sm font-bold text-white/80">May 2026</p>
                    </div>
                    <div class="text-left">
                        <p class="text-[9px] text-white/30 font-black uppercase tracking-widest mb-1">Status</p>
                        <p class="text-sm font-bold text-green-400">Verified</p>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="mt-8 space-y-4">
             @if (User.Identity?.IsAuthenticated == true)
             {
                @if (user?.Role == Role.Admin || user?.Role == Role.Owner)
                {
                    <a href="/Admin/Index" class="w-full glass p-5 rounded-2xl flex items-center justify-between group hover:bg-indigo-500/10 border border-indigo-500/5 transition-all">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 flex items-center justify-center text-indigo-400"><i class="fas fa-shield-alt"></i></div>
                            <span class="font-bold text-indigo-400">Admin Console</span>
                        </div>
                    </a>
                }
                <form asp-controller="Account" asp-action="Logout" method="post">
                    <button type="submit" class="w-full glass p-5 rounded-2xl flex items-center justify-between group hover:bg-red-500/10 border border-red-500/5 transition-all">
                        <div class="flex items-center gap-4">
                            <div class="w-10 h-10 rounded-xl bg-red-500/10 flex items-center justify-center text-red-400"><i class="fas fa-sign-out-alt"></i></div>
                            <span class="font-bold text-red-400">Sign Out</span>
                        </div>
                    </button>
                </form>
             }
             else
             {
                 <a href="/Account/Login" class="w-full btn-primary py-5 text-center block rounded-2xl font-black tracking-[0.1em]">SIGN IN TO YOUR ACCOUNT</a>
             }
        </div>
    </div>

    <!-- BOTTOM NAVIGATION -->
    <nav class="fixed bottom-0 left-0 right-0 bg-[#0f172a]/80 backdrop-blur-2xl border-t border-white/5 p-4 z-50 flex justify-around items-center">
        <div id="tab-Home" onclick="switchTab('Home')" class="nav-item active flex flex-col items-center cursor-pointer text-white/40 hover:text-indigo-400 transition-all">
            <i class="fas fa-home text-xl mb-1"></i>
            <span class="text-[9px] font-black uppercase tracking-widest">Home</span>
        </div>
        <div id="tab-Inbox" onclick="switchTab('Inbox')" class="nav-item flex flex-col items-center cursor-pointer text-white/40 hover:text-indigo-400 transition-all">
            <i class="fas fa-comment-alt text-xl mb-1"></i>
            <span class="text-[9px] font-black uppercase tracking-widest">Inbox</span>
        </div>
        <div id="tab-Map" onclick="switchTab('Map')" class="nav-item flex flex-col items-center cursor-pointer text-white/40 hover:text-indigo-400 transition-all">
            <i class="fas fa-map-marked-alt text-xl mb-1"></i>
            <span class="text-[9px] font-black uppercase tracking-widest">Map</span>
        </div>
        <div id="tab-Tickets" onclick="switchTab('Tickets')" class="nav-item flex flex-col items-center cursor-pointer text-white/40 hover:text-indigo-400 transition-all">
            <i class="fas fa-ticket-alt text-xl mb-1"></i>
            <span class="text-[9px] font-black uppercase tracking-widest">Tickets</span>
        </div>
        <div id="tab-Trips" onclick="switchTab('Trips')" class="nav-item flex flex-col items-center cursor-pointer text-white/40 hover:text-indigo-400 transition-all">
            <i class="fas fa-route text-xl mb-1"></i>
            <span class="text-[9px] font-black uppercase tracking-widest">Trips</span>
        </div>
        <div id="tab-Profile" onclick="switchTab('Profile')" class="nav-item flex flex-col items-center cursor-pointer text-white/40 hover:text-indigo-400 transition-all">
            <i class="fas fa-user text-xl mb-1"></i>
            <span class="text-[9px] font-black uppercase tracking-widest">Profile</span>
        </div>
    </nav>
</div>

@section Scripts {
    <!-- LEAFLET JS & CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@@1.9.4/dist/leaflet.js"></script>

    <script>
        // --- 1. CORE NAVIGATION ---
        window.switchTab = function(tabName) {
            console.log("Switching to:", tabName);
            
            // Hide all views
            document.querySelectorAll('.tab-view').forEach(view => {
                view.classList.remove('active');
            });
            
            // Deactivate all nav items
            document.querySelectorAll('.nav-item').forEach(item => {
                item.classList.remove('active');
            });
            
            // Show selected view
            const selectedView = document.getElementById(`view-${tabName}`);
            if (selectedView) selectedView.classList.add('active');
            
            // Activate selected nav item
            const selectedTab = document.getElementById(`tab-${tabName}`);
            if (selectedTab) selectedTab.classList.add('active');

            // Specialized Init
            if (tabName === 'Map') {
                setTimeout(initMap, 100);
            }
        };

        // --- 2. MAP LOGIC ---
        let leafletMap = null;
        function initMap() {
            if (!leafletMap && document.getElementById('matatuMap')) {
                leafletMap = L.map('matatuMap', { 
                    zoomControl: false,
                    attributionControl: false 
                }).setView([0.3476, 32.5825], 14);

                L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png').addTo(leafletMap);

                // Add Demo Markers
                const taxiIcon = L.divIcon({
                    className: 'taxi-marker',
                    html: '<div style="background:#818cf8;width:12px;height:12px;border:2px solid white;border-radius:50%;box-shadow:0 0 10px rgba(129,140,248,0.8);"></div>'
                });

                L.marker([0.3136, 32.5756], {icon: taxiIcon}).addTo(leafletMap).bindPopup('<b>Old Taxi Park</b><br/>Central Kampala Hub');
                L.marker([0.3166, 32.5746], {icon: taxiIcon}).addTo(leafletMap).bindPopup('<b>New Taxi Park</b>');
                L.marker([0.3556, 32.5925], {icon: taxiIcon}).addTo(leafletMap).bindPopup('<b>Ntinda Stage</b>');
            }
            if (leafletMap) leafletMap.invalidateSize();
        }

        function flyToHub(hub) {
            if (!leafletMap) return;
            const hubs = {
                'old': [0.3136, 32.5756],
                'new': [0.3166, 32.5746],
                'ntinda': [0.3556, 32.5925]
            };
            leafletMap.flyTo(hubs[hub], 16);
        }

        // Initialize Home on start
        window.addEventListener('DOMContentLoaded', () => {
            console.log("Dashboard Ready");
        });
    </script>
}
