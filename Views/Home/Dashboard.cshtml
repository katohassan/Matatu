@using Microsoft.AspNetCore.Identity
@using MatatuMVC.Models
@inject UserManager<User> UserManager

@{
    ViewData["Title"] = "Dashboard";
    var user = await UserManager.GetUserAsync(User);
}

<div class="p-8 pb-32 min-h-screen relative">
    <header class="flex justify-between items-center mb-16 border-b border-white/5 pb-8 pt-8">
        <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-2xl glass p-0.5 shadow-indigo-500/20">
                <img src="https://api.dicebear.com/7.x/avataaars/svg?seed=@(user?.Name ?? "Guest")" alt="Profile" class="w-full h-full rounded-2xl object-cover" />
            </div>
            <div>
                <p class="label-mono mb-0.5">Welcome Back</p>
                <h3 class="text-3xl font-bold tracking-tight text-white font-display">@(user?.Name ?? "User")</h3>
            </div>
        </div>
        <div class="flex items-center gap-3">
            <button class="w-12 h-12 glass rounded-2xl flex items-center justify-center text-white/70 hover:text-white transition-colors relative">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
                <div class="absolute top-3 right-3 w-2 h-2 bg-indigo-400 rounded-full border-2 border-slate-900 shadow-[0_0_10px_rgba(129,140,248,0.5)]"></div>
            </button>
            <form asp-controller="Account" asp-action="Logout" method="post" id="logoutForm">
                <button type="submit" class="w-12 h-12 glass rounded-2xl flex items-center justify-center text-red-400 hover:text-red-300 transition-colors">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" x2="9" y1="12" y2="12"/></svg>
                </button>
            </form>
        </div>
    </header>

    <div class="card-premium mb-12 relative group">
        <div class="absolute -top-4 -right-4 py-2 px-6 glass rounded-2xl label-mono text-white/60">Transit Radar</div>
        <div class="space-y-10 pt-4">
            <div class="flex items-center gap-6 relative">
                <div class="w-10 h-10 rounded-2xl bg-indigo-500/10 flex items-center justify-center border border-indigo-500/20 z-10">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-indigo-400"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                </div>
                <div><p class="label-mono mb-1">Departure</p><h4 class="font-bold text-2xl text-white tracking-tight">Old Taxi Park</h4></div>
                <div class="absolute left-[19px] top-10 w-0.5 h-14 border-l-2 border-indigo-500/10 border-dashed"></div>
            </div>
            
            <div class="flex items-center gap-6 group hover:bg-white/5 p-2 -m-2 rounded-2xl transition-colors relative">
                <div class="w-10 h-10 rounded-2xl bg-white/5 flex items-center justify-center border border-white/10 z-10 group-focus-within:bg-indigo-500/20 group-focus-within:border-indigo-500/30 transition-all">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-white/40 rotate-[225deg] group-focus-within:text-indigo-400 transition-colors"><polyline points="15 18 9 12 15 6"/></svg>
                </div>
                <div class="flex-1">
                    <p class="label-mono mb-1">Destination</p>
                    <input id="destinationInput" type="text" placeholder="Search Hub..." class="bg-transparent font-bold text-2xl tracking-tight text-white placeholder-white/50 outline-none w-full border-none focus:ring-0 p-0 transition-all" />
                </div>
            </div>
        </div>
        
        <div class="flex gap-4 mt-12">
            <button class="flex-1 glass py-4 rounded-2xl label-mono flex items-center justify-center gap-2 hover:bg-white/10 transition-all"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="4" rx="2" ry="2"/><line x1="16" x2="16" y1="2" y2="6"/><line x1="8" x2="8" y1="2" y2="6"/><line x1="3" x2="21" y1="10" y2="10"/></svg> Today</button>
            <button class="flex-1 glass py-4 rounded-2xl label-mono flex items-center justify-center gap-2 hover:bg-white/10 transition-all"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg> 1 Person</button>
        </div>
        <button onclick="scanAvailability()" class="btn-primary mt-8 hover:scale-[1.02] active:scale-[0.98] transition-transform">SCAN HUB AVAILABILITY</button>
        
        <!-- Search Results (Hidden by default) -->
        <div id="searchResults" class="hidden mt-8 space-y-4 opacity-0 transition-opacity duration-500">
            <h4 class="label-mono text-white/30 text-[8px] uppercase tracking-[0.3em]">Live Departures</h4>
            
            <div class="glass p-4 rounded-2xl border-l-4 border-l-green-400 hover:bg-white/10 transition-colors cursor-pointer">
                <div class="flex justify-between items-center mb-2">
                    <h5 class="font-bold text-white">Kisaasi via Bukoto</h5>
                    <span class="text-xs font-bold text-green-400 bg-green-400/10 px-2 py-1 rounded-md">Departing Now</span>
                </div>
                <div class="flex justify-between items-center text-sm text-white/50">
                    <span><i class="fas fa-chair mr-1"></i> 2 Seats Left</span>
                    <span class="font-bold text-white">UGX 2,000</span>
                </div>
            </div>
            
            <div class="glass p-4 rounded-2xl border-l-4 border-l-yellow-400 hover:bg-white/10 transition-colors cursor-pointer">
                <div class="flex justify-between items-center mb-2">
                    <h5 class="font-bold text-white">Ntinda via Kira Rd</h5>
                    <span class="text-xs font-bold text-yellow-400 bg-yellow-400/10 px-2 py-1 rounded-md">In 5 mins</span>
                </div>
                <div class="flex justify-between items-center text-sm text-white/50">
                    <span><i class="fas fa-chair mr-1"></i> 8 Seats Left</span>
                    <span class="font-bold text-white">UGX 2,500</span>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-12">
        <h4 class="label-mono text-white/30 text-[8px] mb-6 uppercase tracking-[0.3em]">Popular Transit Hubs</h4>
        <div class="flex gap-4 overflow-x-auto pb-4 scrollbar-hide">
            <div onclick="setDestination('Old Taxi Park')" class="glass min-w-[200px] p-6 rounded-3xl border-white/5 hover:border-indigo-500/30 transition-all cursor-pointer group shrink-0 active:scale-95">
                <div class="w-10 h-10 rounded-2xl bg-indigo-500/10 flex items-center justify-center mb-4 text-indigo-400 group-hover:bg-indigo-500 group-hover:text-white transition-all">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                </div>
                <h5 class="font-bold text-white mb-0.5">Old Taxi Park</h5>
                <p class="label-mono text-[8px] text-white/20 uppercase tracking-widest">Central Zone</p>
            </div>
            <div onclick="setDestination('New Taxi Park')" class="glass min-w-[200px] p-6 rounded-3xl border-white/5 hover:border-indigo-500/30 transition-all cursor-pointer group shrink-0 active:scale-95">
                <div class="w-10 h-10 rounded-2xl bg-indigo-500/10 flex items-center justify-center mb-4 text-indigo-400 group-hover:bg-indigo-500 group-hover:text-white transition-all">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="3 11 22 2 13 21 11 13 3 11"/></svg>
                </div>
                <h5 class="font-bold text-white mb-0.5">New Taxi Park</h5>
                <p class="label-mono text-[8px] text-white/20 uppercase tracking-widest">Central Zone</p>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-5 mb-8">
        <div onclick="loadFavorites()" class="glass p-6 rounded-3xl cursor-pointer hover:bg-white/15 transition-all group active:scale-95">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-4 bg-white/5 text-indigo-400 group-hover:bg-indigo-500/20">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
            </div>
            <h5 class="font-bold text-white mb-0.5">Favorites</h5>
            <p class="text-[10px] font-medium text-white/30 uppercase tracking-wider">Frequent Stage</p>
        </div>
        <div onclick="loadWallet()" class="glass p-6 rounded-3xl cursor-pointer hover:bg-white/15 transition-all group active:scale-95">
            <div class="w-12 h-12 rounded-2xl flex items-center justify-center mb-4 bg-indigo-500 text-white shadow-lg shadow-indigo-500/40">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"/><path d="M3 5v14a2 2 0 0 0 2 2h16v-5"/><path d="M18 12a2 2 0 0 0 0 4h4v-4Z"/></svg>
            </div>
            <h5 class="font-bold text-white mb-0.5">Wallet</h5>
            <p class="text-[10px] font-medium text-white/30 uppercase tracking-wider">UGX 14,000</p>
        </div>
    </div>

    <!-- Hidden Details Panels -->
    <div id="favoritesDetails" class="hidden mb-14 space-y-3 opacity-0 transition-opacity duration-500">
        <h4 class="label-mono text-white/30 text-[8px] uppercase tracking-[0.3em]">Saved Routes</h4>
        <div class="glass p-4 rounded-2xl flex justify-between items-center hover:bg-white/10 transition-colors cursor-pointer" onclick="setDestination('Makerere Kikoni')">
            <div class="flex items-center gap-3">
                <i class="fas fa-star text-yellow-400"></i>
                <span class="font-bold">Makerere Kikoni</span>
            </div>
            <i class="fas fa-chevron-right text-white/30 text-xs"></i>
        </div>
        <div class="glass p-4 rounded-2xl flex justify-between items-center hover:bg-white/10 transition-colors cursor-pointer" onclick="setDestination('Ntinda')">
            <div class="flex items-center gap-3">
                <i class="fas fa-star text-yellow-400"></i>
                <span class="font-bold">Ntinda via Kisaasi</span>
            </div>
            <i class="fas fa-chevron-right text-white/30 text-xs"></i>
        </div>
    </div>

    <div id="walletDetails" class="hidden mb-14 space-y-3 opacity-0 transition-opacity duration-500">
        <h4 class="label-mono text-white/30 text-[8px] uppercase tracking-[0.3em]">Recent Transactions</h4>
        <div class="glass p-4 rounded-2xl flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-red-500/20 text-red-400 flex items-center justify-center"><i class="fas fa-arrow-down text-xs"></i></div>
                <div>
                    <span class="font-bold block text-sm">Trip to Kisaasi</span>
                    <span class="text-[10px] text-white/40">Today, 08:30 AM</span>
                </div>
            </div>
            <span class="font-bold text-red-400">-UGX 2,000</span>
        </div>
        <div class="glass p-4 rounded-2xl flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-green-500/20 text-green-400 flex items-center justify-center"><i class="fas fa-arrow-up text-xs"></i></div>
                <div>
                    <span class="font-bold block text-sm">Mobile Money Top-up</span>
                    <span class="text-[10px] text-white/40">Yesterday</span>
                </div>
            </div>
            <span class="font-bold text-green-400">+UGX 10,000</span>
        </div>
        <button class="w-full bg-indigo-500 hover:bg-indigo-600 text-white font-bold py-3 rounded-xl transition-colors mt-2 text-sm shadow-lg shadow-indigo-500/20">TOP UP WALLET</button>
    </div>

    <!-- Bottom Nav -->
    <nav class="bottom-nav">
        <div class="nav-item active"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg><span class="mt-1">Home</span></div>
        <div class="nav-item"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span class="mt-1">Inbox</span></div>
        <div class="nav-item"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/><line x1="7" x2="7" y1="15" y2="15"/><line x1="12" x2="12" y1="15" y2="15"/><line x1="17" x2="17" y1="15" y2="15"/></svg><span class="mt-1">Trips</span></div>
        <div class="nav-item"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg><span class="mt-1">Profile</span></div>
    </nav>
</div>

@section Scripts {
    <script>
        function showToast(message, type = 'info') {
            const toast = document.createElement('div');
            const colorClass = type === 'success' ? 'bg-indigo-500 shadow-indigo-500/30' : 'bg-slate-800 shadow-slate-900/50';
            toast.className = `fixed top-6 left-1/2 -translate-x-1/2 px-6 py-3.5 rounded-2xl ${colorClass} text-white font-medium text-sm shadow-xl z-50 flex items-center gap-3 transition-all duration-[400ms] ease-out transform -translate-y-16 opacity-0 border border-white/10`;
            
            toast.innerHTML = `
                <i class="fas fa-${type === 'success' ? 'check-circle' : 'circle-notch fa-spin text-indigo-400'}"></i>
                <span class="tracking-wide">${message}</span>
            `;
            
            document.body.appendChild(toast);
            
            // Animate in
            requestAnimationFrame(() => {
                setTimeout(() => {
                    toast.classList.remove('-translate-y-16', 'opacity-0');
                    toast.classList.add('translate-y-0', 'opacity-100');
                }, 10);
            });
            
            // Animate out
            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('-translate-y-16', 'opacity-0');
                setTimeout(() => toast.remove(), 400);
            }, 2500);
        }

        function scanAvailability() {
            showToast('Scanning live matatu availability...', 'success');
            
            const resultsDiv = document.getElementById('searchResults');
            
            // Simulate network delay then show results
            setTimeout(() => {
                resultsDiv.classList.remove('hidden');
                // Tiny delay to allow display block to apply before opacity transition
                requestAnimationFrame(() => {
                    resultsDiv.classList.remove('opacity-0');
                });
                
                showToast('Found 2 available matatus!', 'success');
            }, 1500);
        }

        function setDestination(hubName) {
            const input = document.getElementById('destinationInput');
            input.value = hubName;
            
            // Add a little pulse animation to the input
            input.classList.add('text-indigo-400');
            setTimeout(() => {
                input.classList.remove('text-indigo-400');
            }, 300);

            showToast(`Destination set to ${hubName}`, 'success');
        }

        function hideAllPanels() {
            const favs = document.getElementById('favoritesDetails');
            const wallet = document.getElementById('walletDetails');
            favs.classList.add('hidden', 'opacity-0');
            wallet.classList.add('hidden', 'opacity-0');
        }

        function loadFavorites() {
            showToast('Loading your favorite routes...', 'info');
            hideAllPanels();
            const panel = document.getElementById('favoritesDetails');
            setTimeout(() => {
                panel.classList.remove('hidden');
                requestAnimationFrame(() => panel.classList.remove('opacity-0'));
            }, 600);
        }

        function loadWallet() {
            showToast('Accessing Wallet...', 'info');
            hideAllPanels();
            const panel = document.getElementById('walletDetails');
            setTimeout(() => {
                panel.classList.remove('hidden');
                requestAnimationFrame(() => panel.classList.remove('opacity-0'));
            }, 600);
        }
    </script>
}
